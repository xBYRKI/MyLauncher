{
  // Strg+Umschalt+B = Bauen, alles andere über "Tasks: Run Task"
  "version": "2.0.0",
  "inputs": [
    {
      "id": "notes",
      "type": "promptString",
      "description": "Änderungstext für das Update (erscheint im Launcher)"
    },
    {
      "id": "packId",
      "type": "promptString",
      "description": "Modpack-ID auf dem Server (Kleinbuchstaben, Ziffern, - und _)"
    },
    {
      "id": "packDir",
      "type": "promptString",
      "description": "Lokaler Pack-Ordner (mit files\\ und defaults\\ oder direkt die Spieldateien)"
    },
    {
      "id": "adminPassword",
      "type": "promptString",
      "description": "Admin-Passwort für die Oberfläche unter http://127.0.0.1:8787/admin/ (mind. 12 Zeichen)",
      "default": "admin-lokal-test"
    }
  ],
  "tasks": [
    {
      "label": "Launcher: Bauen",
      "type": "shell",
      "command": "cargo build -p mylauncher",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Launcher: Starten",
      "type": "shell",
      "command": "cargo run -p mylauncher",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Launcher: Release bauen",
      "type": "shell",
      "command": "cargo build --release -p mylauncher",
      "group": "build",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Setup: Installer bauen (unsigniert)",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-setup.ps1",
      "group": "build",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Release: Signiert bauen",
      "detail": "Braucht SimplySign Desktop (angemeldet)",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-signed.ps1",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Release: Signiert bauen & veröffentlichen",
      "detail": "Legt das GitHub-Release v<Version> an – der Launcher bietet es dann allen als Update an",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-signed.ps1 -Notes \"${input:notes}\" -Publish",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Eigener Server: Deploy (SSH)",
      "detail": "Baut mylauncher-server für Linux und installiert ihn laut scripts/server.config.json",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-server.ps1",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Eigener Server: Admin-Oberfläche (SSH-Tunnel)",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/server-admin.ps1",
      "problemMatcher": []
    },
    {
      "label": "Eigener Server: Log",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/server-logs.ps1",
      "problemMatcher": []
    },
    {
      "label": "Eigener Server: Modpack hochladen",
      "detail": "Gleicht den Ordner per SHA1 ab, lädt nur Änderungen hoch und veröffentlicht",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish-pack.ps1 -Pack \"${input:packId}\" -Dir \"${input:packDir}\" -Notes \"${input:notes}\"",
      "problemMatcher": []
    },
    {
      "label": "Prüfen: Tests",
      "type": "shell",
      "command": "cargo test --workspace",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Prüfen: Clippy",
      "type": "shell",
      "command": "cargo clippy --workspace --all-targets",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Server: lokal starten",
      "type": "shell",
      "command": "cargo run -p mylauncher-server -- --bind 127.0.0.1:8787 --data target/server-data --admin-password ${input:adminPassword}",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Modpack-Server: Integrationstest",
      "detail": "Erwartet den lokalen Server mit mindestens einem veröffentlichten, sichtbaren Modpack",
      "type": "shell",
      "command": "cargo test -p launcher-core --test remote_config -- --ignored",
      "options": {
        "env": { "LAUNCHER_TEST_URL": "http://127.0.0.1:8787" }
      },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Packtool: Hilfe",
      "type": "shell",
      "command": "cargo run -p launcher-core --bin packtool",
      "problemMatcher": ["$rustc"]
    }
  ]
}
