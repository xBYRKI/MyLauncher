{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyLauncher",
  "version": "0.2.0",
  "identifier": "dev.byrki.mylauncher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MyLauncher",
        "width": 1180,
        "height": 740,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "backgroundColor": "#001a3f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "publisher": "Lukas Stephanides",
    "copyright": "Stephanides IT e.U.",
    "shortDescription": "Minecraft-Launcher mit Prism Launcher als Engine",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
